# Padrão: integração real com a API Spring Boot local, via proxy do Vite.
# Não é necessário informar VITE_API_URL ao executar npm run dev localmente.
VITE_DEMO_MODE=false
# Somente se quiser usar a interface com dados FICTÍCIOS sem banco/API:
# VITE_DEMO_MODE=true
# Se publicar separadamente, configure o proxy equivalente no servidor web.
